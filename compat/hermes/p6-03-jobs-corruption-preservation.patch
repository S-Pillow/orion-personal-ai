+def _preserve_jobs_file_before_repair(jobs_file: Path, reason: str) -> Path:
+    """Preserve exact on-disk jobs.json bytes before an automatic repair rewrite."""
+    recovery_dir = jobs_file.parent / "recovery"
+    recovery_dir.mkdir(parents=True, exist_ok=True)
+
+    safe_reason = re.sub(r"[^a-z0-9_-]+", "-", str(reason).strip().lower()).strip("-")
+    if not safe_reason:
+        safe_reason = "unspecified-repair"
+
+    final_path = recovery_dir / (
+        f"jobs.json.{time.time_ns()}.{os.getpid()}.{safe_reason}.original"
+    )
+    fd, tmp_name = tempfile.mkstemp(
+        prefix=f".{final_path.name}.",
+        suffix=".tmp",
+        dir=str(recovery_dir),
+    )
+    try:
+        with open(jobs_file, "rb") as src, os.fdopen(fd, "wb") as dst:
+            while True:
+                chunk = src.read(1024 * 1024)
+                if not chunk:
+                    break
+                dst.write(chunk)
+            dst.flush()
+            os.fsync(dst.fileno())
+
+        os.replace(tmp_name, final_path)
+
+        # The accepted Hermes pin has no shared fsync_directory helper.
+        # On POSIX, fsync the directory entry after publication. Windows does
+        # not support opening directories this way; the artifact file itself
+        # has already been flushed and fsynced before os.replace().
+        if os.name != "nt":
+            dir_flags = os.O_RDONLY | getattr(os, "O_DIRECTORY", 0)
+            dir_fd = os.open(str(recovery_dir), dir_flags)
+            try:
+                os.fsync(dir_fd)
+            finally:
+                os.close(dir_fd)
+    except Exception:
+        try:
+            os.close(fd)
+        except OSError:
+            pass
+        try:
+            os.unlink(tmp_name)
+        except OSError:
+            pass
+        raise
+
+    return final_path
+
